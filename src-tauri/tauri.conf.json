{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicLocker",
  "version": "1.0.0",
  "identifier": "com.miclocker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MicLocker",
        "width": 380,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}